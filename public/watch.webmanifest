{
  "name": "Remotie Watch",
  "short_name": "Watch",
  "description": "Viewer app for watching the current Remotie stream.",
  "start_url": "/watch",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0f12",
  "theme_color": "#20c997",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/watch-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/watch-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/watch.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
